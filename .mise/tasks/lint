#!/usr/bin/env bash
# mise description: Run ShellCheck over the task scripts

set -euo pipefail

if ! command -v shellcheck &> /dev/null; then
    echo "Error: 'shellcheck' is not installed or not in PATH."
    echo "Install it with: brew install shellcheck"
    exit 1
fi

cd "$MISE_PROJECT_ROOT"

shellcheck --version

# Fail on warnings and above; informational hints stay advisory.
find .mise/tasks -type f -print0 \
    | xargs -0 shellcheck --external-sources --severity=warning --shell=bash

echo "ShellCheck passed."
